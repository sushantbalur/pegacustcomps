{
  "$comment": "Machine-readable catalogue of every component type and subtype this library can generate. Single source of truth for the generate-component-set and identify-components skills \u2014 do not duplicate these lists in markdown.",
  "namePrefix": "<Org>_<Library>_",
  "namePrefixComment": "Not a literal. <Org> is the organization in package.json and <Library> is the library created with createLib (component.library in tasks.config.json).",
  "outputPath": "src/components/{namePrefix}{Name}",
  "skillRoot": ".claude/skills",
  "referenceRoot": ".claude/skills/create-dx-component/references",
  "assetRoot": ".claude/skills/create-dx-component/assets",
  "sharedAssets": ["PConnProps.d.ts", "create-nonce.ts", "styles.ts", "event-utils.ts"],
  "componentFiles": ["index.tsx", "config.json", "styles.ts", "mock.ts", "demo.stories.tsx", "demo.test.tsx"],
  "types": {
    "Field": {
      "skill": "field/SKILL.md",
      "catalogue": "fixed",
      "subtypes": [
        {
          "subtype": "Text",
          "cliSubtype": "Text",
          "skill": "text/SKILL.md",
          "cosmos": "Input / TextArea"
        },
        {
          "subtype": "Boolean",
          "cliSubtype": "Boolean",
          "skill": "boolean/SKILL.md",
          "cosmos": "Checkbox / BooleanDisplay"
        },
        {
          "subtype": "Integer",
          "cliSubtype": "Integer",
          "skill": "integer/SKILL.md",
          "cosmos": "NumberInput"
        },
        {
          "subtype": "Decimal",
          "cliSubtype": "Decimal",
          "skill": "decimal/SKILL.md",
          "cosmos": "NumberInput"
        },
        {
          "subtype": "Currency",
          "cliSubtype": "Decimal-Currency",
          "skill": "currency/SKILL.md",
          "cosmos": "CurrencyInput / CurrencyDisplay"
        },
        {
          "subtype": "Percentage",
          "cliSubtype": "Decimal-Percentage",
          "skill": "percentage/SKILL.md",
          "cosmos": "NumberInput with % suffix"
        },
        {
          "subtype": "Date",
          "cliSubtype": "Date",
          "skill": "date/SKILL.md",
          "cosmos": "DateInput / DateTimeDisplay"
        },
        {
          "subtype": "Email",
          "cliSubtype": "Text-Email",
          "skill": "email/SKILL.md",
          "cosmos": "Input type=email / EmailDisplay"
        },
        {
          "subtype": "Phone",
          "cliSubtype": "Text-Phone",
          "skill": "phone/SKILL.md",
          "cosmos": "PhoneInput / PhoneDisplay"
        },
        {
          "subtype": "URL",
          "cliSubtype": "Text-URL",
          "skill": "url/SKILL.md",
          "cosmos": "Input type=url / URLDisplay"
        },
        {
          "subtype": "Picklist",
          "cliSubtype": "Picklist",
          "skill": "picklist/SKILL.md",
          "cosmos": "Select"
        },
        {
          "subtype": "RadioButtons",
          "cliSubtype": "Picklist-RadioButtons",
          "skill": "radiobuttons/SKILL.md",
          "cosmos": "RadioButtonGroup"
        }
      ]
    },
    "Template": {
      "skill": "template/SKILL.md",
      "catalogue": "fixed",
      "subtypes": [
        {
          "subtype": "FORM",
          "cliSubtype": "FORM",
          "skill": "form/SKILL.md",
          "cosmos": "Grid / FieldGroup / Flex",
          "renders": "Editable layout that arranges input children"
        },
        {
          "subtype": "DETAILS",
          "cliSubtype": "DETAILS",
          "skill": "details/SKILL.md",
          "cosmos": "FieldValueList / Grid / Card",
          "renders": "Read-only label/value summary of children"
        },
        {
          "subtype": "PAGE",
          "cliSubtype": "PAGE",
          "skill": "page/SKILL.md",
          "cosmos": "Grid / Flex / Card",
          "renders": "Whole-page region layout, portal shell"
        }
      ]
    },
    "Widget": {
      "skill": "widget/SKILL.md",
      "catalogue": "user-supplied",
      "$comment": "Widgets have no default list. The user must name each one, its scope, and its data source.",
      "subtypes": [
        {
          "subtype": "CASE",
          "cliSubtype": "CASE",
          "skill": "case/SKILL.md",
          "cosmos": "Card / CardHeader / CardContent",
          "renders": "Case-scoped chart, KPI, or related-records block"
        },
        {
          "subtype": "PAGE_WIDGET",
          "cliSubtype": "PAGE",
          "skill": "page-widget/SKILL.md",
          "cosmos": "Card / CardHeader / CardContent",
          "renders": "Dashboard tile or portal block with no case context"
        }
      ]
    },
    "Presentation": {
      "skill": "presentation/SKILL.md",
      "catalogue": "user-supplied",
      "$comment": "Presentation components replace how a whole case view is rendered. The user chooses the subtype (CASEVIEW or WSSCASEVIEW) and the name; there is no default set. They take all data as props and cannot use PCore or getPConnect. For badges, formatters and other read-only displays use a Field or a Widget instead.",
      "subtypes": [
        {
          "subtype": "CASEVIEW",
          "cliSubtype": "CASEVIEW",
          "skill": "presentation/SKILL.md",
          "cosmos": "CaseViewProps from @pega/cosmos-react-work",
          "renders": "Replacement case view"
        },
        {
          "subtype": "WSSCASEVIEW",
          "cliSubtype": "WSSCASEVIEW",
          "skill": "presentation/SKILL.md",
          "cosmos": "CaseViewProps from @pega/cosmos-react-wss",
          "renders": "Replacement case view for Web Self Service"
        }
      ]
    }
  },
  "cliSubtypeComment": "cliSubtype is the exact <subtype> argument for 'npm run create -- <type> <subtype> ...'. Use it instead of the display name."
}
